; Trio Adventures — 2.5D test (Godot 4.7)
; Open this folder in Godot (Import → pick this project.godot), then press Play (F5).

config_version=5

[application]

config/name="Trio Adventures"
config/description="Trio Adventures — a goofy 2.5D RPG by Ebain."
run/main_scene="res://title.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.png"
config/windows_native_icon="res://icon.ico"
boot_splash/bg_color=Color(0.03, 0.02, 0.055, 1)
boot_splash/image="res://splash.png"
boot_splash/fullsize=false
boot_splash/use_filter=true

[autoload]

Game="*res://scripts/game.gd"

[audio]

general/text_to_speech=true

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
